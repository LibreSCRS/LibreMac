<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- librescrs-prompter, signed by Scripts/sign-bundle.sh. Its own
	     sandbox, NOT inherit: an inherit-sandboxed child spawned by the agent
	     cannot RegisterApplication; the prompter is a standalone sandboxed
	     LaunchAgent. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Exactly one App Group. sign-bundle.sh signs from a copy in which it
	     is replaced by the group the bundle's team names
	     (<team>.org.librescrs.LibreMac; this one when there is no team);
	     verify-bundle.sh refuses a signature that holds any other group or more
	     than one. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.librescrs.LibreMac</string>
	</array>
</dict>
</plist>
