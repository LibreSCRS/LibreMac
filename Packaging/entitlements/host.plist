<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Host app (LibreMac.app). Signed by Scripts/sign-bundle.sh, the only
	     entitlement source: project.yml names none. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Exactly one App Group. sign-bundle.sh signs from a copy in which it
	     is replaced by the group the bundle's team names
	     (<team>.org.librescrs.LibreMac; this one when there is no team);
	     verify-bundle.sh refuses a signature that holds any other group or more
	     than one. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.librescrs.LibreMac</string>
	</array>
	<!-- Typed paths: Downloads by entitlement, the chosen default output
	     folder by security-scoped bookmark (the panel's grant ends with the
	     process; the bookmark carries it across a relaunch). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
