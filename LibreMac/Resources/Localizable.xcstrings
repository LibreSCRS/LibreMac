    "lc-agent-awaiting-preauth" : {
      "comment" : "lc-agent-awaiting-preauth",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm the card access number in the system dialog to continue reading this card."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потврдите број за приступ картици у системском прозору да би читање картице било настављено."
          }
        }
      }
    },
    "lc-agent-call-access-denied" : {
      "comment" : "lc-agent-call-access-denied",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission to use the smart card service was denied."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приступ услузи за паметне картице је одбијен."
          }
        }
      }
    },
    "lc-agent-call-invalid-arguments" : {
      "comment" : "lc-agent-call-invalid-arguments",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request was refused before any work on it started."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овај захтев је одбијен пре него што је било шта урађено."
          }
        }
      }
    },
    "lc-agent-call-protocol" : {
      "comment" : "lc-agent-call-protocol",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smart card service replied in a way this application does not understand. The two may be different versions."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услуга за паметне картице је одговорила на начин који овај програм не разуме. Могуће је да су различитих верзија."
          }
        }
      }
    },
    "lc-agent-call-timeout" : {
      "comment" : "lc-agent-call-timeout",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smart card service did not answer in time. Try again."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услуга за паметне картице није одговорила на време. Покушајте поново."
          }
        }
      }
    },
    "lc-agent-call-transport" : {
      "comment" : "lc-agent-call-transport",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection to the smart card service was lost. Try again."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веза са услугом за паметне картице је прекинута. Покушајте поново."
          }
        }
      }
    },
    "lc-agent-call-unavailable" : {
      "comment" : "lc-agent-call-unavailable",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach the smart card service. Check that it is installed and running."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услуга за паметне картице није доступна. Проверите да ли је инсталирана и покренута."
          }
        }
      }
    },
    "lc-agent-error-artifact-write" : {
      "comment" : "lc-agent-error-artifact-write",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document was signed, but the signed file could not be written to the output folder."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Документ је потписан, али потписани фајл није могао да се упише у излазну фасциклу."
          }
        }
      }
    },
    "lc-agent-error-auth-failed" : {
      "comment" : "lc-agent-error-auth-failed",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication with the card failed."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аутентификација са картицом није успела."
          }
        }
      }
    },
    "lc-agent-error-capability-missing" : {
      "comment" : "lc-agent-error-capability-missing",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This card does not support the requested operation."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова картица не подржава тражену операцију."
          }
        }
      }
    },
    "lc-agent-error-card-removed" : {
      "comment" : "lc-agent-error-card-removed",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card was removed before the operation finished."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картица је уклоњена пре него што је операција завршена."
          }
        }
      }
    },
    "lc-agent-error-cert-expired-blocked" : {
      "comment" : "lc-agent-error-cert-expired-blocked",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The signing certificate has expired."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат за потписивање је истекао."
          }
        }
      }
    },
    "lc-agent-error-chain-incomplete" : {
      "comment" : "lc-agent-error-chain-incomplete",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate chain could not be completed."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ланац сертификата није могао да се употпуни."
          }
        }
      }
    },
    "lc-agent-error-communication" : {
      "comment" : "lc-agent-error-communication",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communication with the card reader failed."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комуникација са читачем картица није успела."
          }
        }
      }
    },
    "lc-agent-error-credential-blocked" : {
      "comment" : "lc-agent-error-credential-blocked",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card credential is blocked. Unblock it before trying again."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приступни податак картице је блокиран. Одблокирајте га пре поновног покушаја."
          }
        }
      }
    },
    "lc-agent-error-credential-wrong" : {
      "comment" : "lc-agent-error-credential-wrong",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PIN or access code entered was incorrect."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Унети ПИН или приступни код није исправан."
          }
        }
      }
    },
    "lc-agent-error-engine-unavailable" : {
      "comment" : "lc-agent-error-engine-unavailable",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The signing service is not set up correctly — its security module could not be loaded. Check the installation."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услуга за потписивање није исправно подешена — њен безбедносни модул није могао да се учита. Проверите инсталацију."
          }
        }
      }
    },
    "lc-agent-error-entry-expired" : {
      "comment" : "lc-agent-error-entry-expired",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The entry window closed before a code was entered. Try again."
          }
        },
